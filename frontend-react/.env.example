# Frontend environment variables — copy to `.env` and fill in real values.
# The real .env is gitignored. NEVER commit real keys.
#
# NOTE: Vite only exposes vars prefixed with VITE_, and they are baked into the
# built JS bundle — so they are visible to anyone using the app. Only put
# publishable / public values here. True secrets belong on the backend.

# Stripe publishable key (safe to expose).
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# Supabase project (anon key is public by design, protected by row-level security).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Temporary admin account for the dev control panel (/admin).
# This is a PLACEHOLDER until real server-side auth (Supabase) is wired up.
# Because VITE_ vars ship in the bundle, this is NOT a real secret — it only
# keeps the literal value out of the git repo.
VITE_ADMIN_EMAIL=ceo@neonsox.com
VITE_ADMIN_PASSWORD=change_me

# Backend URL for Stripe checkout + Runway generation (Phase B).
VITE_API_BASE=http://localhost:4242

# Set to false once backend/.env has RUNWAY_API_KEY + ELEVENLABS keys and backend is running.
VITE_USE_MOCK_GENERATION=true
