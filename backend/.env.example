# Backend environment variables — copy to `.env` and fill in real values.
# The real .env is gitignored. NEVER commit real keys.

# Stripe secret key (server-side only). Find it in your Stripe dashboard.
STRIPE_SECRET_KEY=sk_test_your_key_here

# Webhook signing secret — optional for local dev (Success page confirms via /api/checkout/confirm).
# For production: Stripe Dashboard → Webhooks → your live URL /api/webhook
STRIPE_WEBHOOK_SECRET=

# Supabase (service role — server only, NEVER expose to frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Admin email — must match the account that signs in at /admin (same as VITE_ADMIN_EMAIL on frontend).
ADMIN_EMAIL=you@example.com

# Base URL of the frontend, used for Stripe success/cancel redirects.
FRONTEND_URL=http://localhost:5173

# ── Runway API (Phase B — server only, NEVER expose to frontend) ──
# Get your key from the Runway developer portal after buying API credits.
RUNWAY_API_KEY=your_runway_api_key_here
RUNWAY_API_VERSION=2024-11-06

# Dev: 10-second clips (gen4.5 API max). Launch: keep at 10 unless Runway adds longer single clips.
RUNWAY_DURATION_SECONDS=10
RUNWAY_RATIO=1280:720

# Text-only ads use gen4.5. If user adds a Logo URL, backend auto-uses gen4_turbo.
RUNWAY_MODEL=gen4.5

# ── ElevenLabs (Option B audio — server only, NEVER expose to frontend) ──
# Sign up at https://elevenlabs.io → Profile → API keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Voice IDs from ElevenLabs → Voice Library (click a voice → copy Voice ID).
# Female voice (default). ELEVENLABS_VOICE_ID still works as a fallback for female.
ELEVENLABS_VOICE_ID_FEMALE=your_female_voice_id_here
ELEVENLABS_VOICE_ID=your_female_voice_id_here
# Male voice — required for the Male gender button in the app.
ELEVENLABS_VOICE_ID_MALE=your_male_voice_id_here
# Set true once backend TTS + music mix is implemented. false = video-only (Runway silent).
# Set to true when ELEVENLABS_API_KEY and ELEVENLABS_VOICE_ID are configured.
ELEVENLABS_AUDIO_ENABLED=true

# Step 6 text overlay uses bundled Google Fonts in backend/assets/fonts/
# If missing, run: npm run fonts

# ── Social posting (proprietary adapters — server only) ──
# Run docs/supabase-social-connections.sql in Supabase before enabling OAuth.
# SOCIAL_POSTING_ENABLED=false until adapters + keys are wired.
SOCIAL_POSTING_ENABLED=false
SOCIAL_TOKEN_ENCRYPTION_KEY=generate_a_long_random_secret_here

# Per-platform keys (add as you wire each adapter in backend/lib/social/adapters/)
# X_API_CLIENT_ID=
# X_API_CLIENT_SECRET=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# BLUESKY_HANDLE=
# BLUESKY_APP_PASSWORD=
# TELEGRAM_BOT_TOKEN=
# DISCORD_WEBHOOK_URL=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=

# ── Clip URL masking (production — hide raw Supabase storage from subscribers) ──
# Generate a long random secret. When set, cloud clip URLs become https://your-api.com/api/clips/<token>
# instead of exposing yqyeznrufsitxljfgibv.supabase.co/...
CLIP_URL_SIGNING_SECRET=
# Public API base (your production backend URL, e.g. https://api.neonsox.com)
PUBLIC_API_BASE=
