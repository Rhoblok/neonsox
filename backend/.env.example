# Backend environment variables — copy to `.env` and fill in real values.
# The real .env is gitignored. NEVER commit real keys.

# Stripe secret key (server-side only). Find it in your Stripe dashboard.
STRIPE_SECRET_KEY=sk_test_your_key_here

# Base URL of the frontend, used for Stripe success/cancel redirects.
FRONTEND_URL=http://localhost:5174
